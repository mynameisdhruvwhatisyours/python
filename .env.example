NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional region pricing overrides.
# If you leave these unset, vedSecure uses built-in defaults:
# India -> INR with local payment methods
# All other countries -> international card checkout
# RAZORPAY_INDIA_PLAN_AMOUNT=1106400
# RAZORPAY_INDIA_PLAN_CURRENCY=INR
# RAZORPAY_INDIA_DISPLAY_PRICE=₹11,064
# RAZORPAY_INTL_PLAN_AMOUNT=12000
# RAZORPAY_INTL_PLAN_CURRENCY=USD
# RAZORPAY_INTL_DISPLAY_PRICE=$120
